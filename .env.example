# 지도 시연에 꼭 필요한 항목은 DB_HOST / DB_USER / DB_PASSWORD 3개뿐입니다. 나머지는 선택(기본값 사용).
# 이 파일을 .env 로 복사해 값을 채우세요. .env 는 저장소에 올라가지 않습니다.

# ===== [필수] KIER RDS 접속 (별도 전달받은 값) =====
DB_HOST=
DB_USER=
DB_PASSWORD=

# ===== [선택] 기본값을 쓰면 됩니다 =====
DB_PORT=3306
DB_NAME=kier_map

# 공공데이터포털 인증키 — 수집 스크립트(collect/)를 다시 실행할 때만 필요 (지도 시연에는 불필요)
DATAGO_KEY=

# 서버 주소·포트 (기본값)
API_HOST=127.0.0.1
API_PORT=5056
MAP_HOST=127.0.0.1
MAP_PORT=5057
# 지도 서버가 /api/* 를 넘겨줄 조회 API 주소
API_UPSTREAM=http://127.0.0.1:5056
# 브라우저가 호출할 API 주소 (비우면 web/index.html 기본값 http://127.0.0.1:5056/api/)
KIER_API_BASE=
